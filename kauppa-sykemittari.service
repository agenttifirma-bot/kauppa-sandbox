[Unit]
Description=Kauppatiimi: sykemittari (vain luku, halytys Telegramiin)
After=network-online.target

[Service]
Type=oneshot
User=kauppa
Group=kauppa
WorkingDirectory=/srv/kauppa/k1
ExecStart=/usr/bin/python3 /srv/kauppa/k1/sykemittari.py
TimeoutStartSec=120
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/srv/kauppa/data
